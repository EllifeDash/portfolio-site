---
import Reading from "../../components/Reading.astro";
import Callout from "../../components/Callout.astro";
import Figure from "../../components/Figure.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "../../config";
import { profile } from "../../data/profile";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const date = data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const words = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(words / 200));

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  keywords: data.tags.join(", "),
  author: { "@type": "Person", name: data.author, url: SITE.domain },
  publisher: { "@type": "Person", name: profile.name, url: SITE.domain },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, SITE.domain).href,
  },
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />

<script>
  const section = document.querySelector(".comments");
  if (section) {
    const slug = section.dataset.slug;
    const list = section.querySelector("#comments-list");
    const form = section.querySelector("#comment-form");
    const status = section.querySelector("#comment-status");

    async function load() {
      try {
        const res = await fetch(
          `/api/comments?slug=${encodeURIComponent(slug)}`
        );
        if (!res.ok) throw new Error("bad response");
        const comments = await res.json();
        list.innerHTML = "";
        if (!Array.isArray(comments) || !comments.length) {
          list.innerHTML =
            '<p class="muted">No comments yet — be the first to share your thoughts.</p>';
          return;
        }
        for (const c of comments) {
          const el = document.createElement("article");
          el.className = "comment";
          const name = document.createElement("p");
          name.className = "comment-name";
          name.textContent = c.name;
          const body = document.createElement("p");
          body.className = "comment-body";
          body.textContent = c.body;
          const time = document.createElement("p");
          time.className = "comment-time muted";
          time.textContent = new Date(c.created_at).toLocaleDateString(
            "en-US",
            { year: "numeric", month: "short", day: "numeric" }
          );
          el.append(name, body, time);
          list.appendChild(el);
        }
      } catch {
        list.innerHTML =
          '<p class="muted">Could not load comments right now.</p>';
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const payload = {
        slug,
        name: String(data.get("name") || "").trim(),
        body: String(data.get("body") || "").trim(),
        website: String(data.get("website") || ""),
      };
      status.textContent = "Submitting…";
      try {
        const res = await fetch("/api/comments", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          form.reset();
          status.textContent =
            "Thanks! Your comment is awaiting moderation.";
          load();
        } else {
          status.textContent = "Something went wrong. Please try again.";
        }
      } catch {
        status.textContent = "Network error. Please try again.";
      }
    });

    load();
  }
</script>

<Reading title={data.title} description={data.description}>
  <a class="link" href="/blog">← All articles</a>
  <p class="eyebrow" style="margin-top:var(--space-5)">{data.tags.join(" · ")}</p>
  <h1>{data.title}</h1>
  <p class="lede">{data.description}</p>

  <hr class="divider" />

  <div class="prose">
    <Content components={{ Callout, Figure }} />
  </div>

  <hr class="divider" />
  <p class="muted">
    Enjoyed this? <a class="link" href="/connect">Say hello →</a>
  </p>

  <section class="comments" data-slug={post.id} aria-live="polite">
    <h2>Comments</h2>
    <div id="comments-list" class="comments-list">
      <p class="muted">Loading comments…</p>
    </div>

    <form id="comment-form" class="comment-form">
      <label class="field">
        <span>Name</span>
        <input type="text" name="name" maxlength="50" required />
      </label>
      <label class="field">
        <span>Comment</span>
        <textarea name="body" maxlength="2000" rows="4" required></textarea>
      </label>
      <input
        type="text"
        name="website"
        class="hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="comment-actions">
        <button type="submit" class="btn btn-primary">Post comment</button>
        <span id="comment-status" class="muted" role="status"></span>
      </div>
    </form>
    <p class="muted comment-note">
      Comments are reviewed before they appear. No account needed.
    </p>
  </section>

  <Fragment slot="aside">
    <div class="aside-block">
      <span class="label">Article</span>
      <ul class="aside-list">
        <li><strong>Published:</strong> {date}</li>
        <li><strong>Author:</strong> {data.author}</li>
        <li><strong>Read:</strong> ~{readingTime} min</li>
        {data.updatedDate && <li><strong>Updated:</strong> {data.updatedDate.toLocaleDateString()}</li>}
      </ul>
    </div>
    <div class="aside-block">
      <span class="label">Topics</span>
      <ul class="aside-list">
        {data.tags.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <div class="aside-block">
      <span class="label">More</span>
      <ul class="aside-list">
        <li><a href="/blog">All articles →</a></li>
        <li><a href="/projects">Selected work →</a></li>
      </ul>
    </div>
  </Fragment>
</Reading>
