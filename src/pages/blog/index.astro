---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog" description="Articles and notes by Abdullah Tayyab on software, operations, and building for local needs">
  <section class="container section">
    <p class="eyebrow">Blog</p>
    <h1>Writing</h1>
    <p class="lede" style="max-width:60ch">
      Notes on offline-first software, government IT, clinic systems, and the craft of
      building things that work.
    </p>

    {
      posts.length === 0 ? (
        <p class="muted" style="margin-top:var(--space-7)">
          No posts yet — check back soon.
        </p>
      ) : (
        <div class="grid grid-2" style="margin-top:var(--space-7)">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      )
    }
  </section>
</Base>
