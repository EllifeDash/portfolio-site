---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => {
  const byDate = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (byDate !== 0) return byDate;
  // Same-day posts: keep a series in reading order, Part 1 first. Without
  // this the tie is resolved by collection order, which is alphabetical and
  // would list Part 2 above Part 1.
  if (a.data.series && a.data.series === b.data.series) {
    return (a.data.part ?? 0) - (b.data.part ?? 0);
  }
  return a.id.localeCompare(b.id);
});
---

<Base title="Blog" description="Articles and notes by Abdullah Tayyab on software, operations, and building for local needs">
  <section class="container section">
    <p class="eyebrow">Blog</p>
    <h1>Writing</h1>
    <p class="lede" style="max-width:60ch">
      Notes on offline-first software, running mission-critical systems, clinic software, and the craft of
      building things that work.
    </p>

    {
      posts.length === 0 ? (
        <p class="muted" style="margin-top:var(--space-7)">
          No posts yet — check back soon.
        </p>
      ) : (
        <div class="grid grid-2" style="margin-top:var(--space-7)">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      )
    }
  </section>
</Base>
