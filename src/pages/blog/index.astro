---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => {
  const byDate = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  if (byDate !== 0) return byDate;
  // Same-day posts: keep a series in reading order, Part 1 first. Without
  // this the tie is resolved by collection order, which is alphabetical and
  // would list Part 2 above Part 1.
  if (a.data.series && a.data.series === b.data.series) {
    return (a.data.part ?? 0) - (b.data.part ?? 0);
  }
  return a.id.localeCompare(b.id);
});
---

<Base
  title="Blog"
  description="Writing on offline-first architecture, software ownership, and building reliable software, by Abdullah Tayyab — full-stack developer in Punjab, Pakistan."
>
  <section class="container section">
    <p class="eyebrow">Blog</p>
    <h1>Writing</h1>
    <p class="lede" style="max-width:60ch">
      Offline-first architecture, software ownership, and the reliability habits I picked up from
      five years running systems where downtime had a real cost. Written from Pakistan, for people
      building where the network is never guaranteed.
    </p>

    {
      posts.length === 0 ? (
        <p class="muted" style="margin-top:var(--space-7)">
          No posts yet — check back soon.
        </p>
      ) : (
        <div class="grid grid-2" style="margin-top:var(--space-7)">
          {posts.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      )
    }
  </section>
</Base>
