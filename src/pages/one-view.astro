---
// /one-view redirects to the full interactive (fancy) portfolio.
// Deploy the `legacy-vite` branch of this repo to portfolio.abdullahtayyab.dev,
// then this route sends visitors there.
const TARGET = "https://portfolio.abdullahtayyab.dev";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content="2; url=https://portfolio.abdullahtayyab.dev" />
    <link rel="canonical" href={TARGET} />
    <title>Redirecting to the full portfolio…</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f6f4f1;
        color: #161412;
        font-family: Georgia, "Times New Roman", serif;
        text-align: center;
        padding: 24px;
      }
      .box {
        max-width: 520px;
      }
      h1 {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.4rem;
        font-weight: 600;
      }
      a {
        color: #0303b4;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #161412;
          color: #f3efe8;
        }
        a {
          color: #5b6bff;
        }
      }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>Taking you to the full interactive portfolio…</h1>
      <p>
        Not redirected? <a href="https://portfolio.abdullahtayyab.dev"
          >Open it here →</a
        >
      </p>
    </div>
    <script is:inline>
      setTimeout(function () {
        window.location.href = "https://portfolio.abdullahtayyab.dev";
      }, 1500);
    </script>
  </body>
</html>
