---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="The page you were looking for doesn't exist">
  <section class="container section stack" style="padding-block:var(--space-10)">
    <p class="eyebrow">404</p>
    <h1>This page took a different route</h1>
    <p class="lede">
      The link may be broken or the page may have moved. Let's get you back on track.
    </p>
    <div class="hero-actions" style="margin-top:var(--space-6)">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-secondary" href="/blog">Read the blog</a>
      <a class="btn btn-secondary" href="/projects">See projects</a>
    </div>
  </section>
</Base>
