---
import Reading from "../components/Reading.astro";
---

<Reading title="Friends" description="People and places I hang out with by Abdullah Tayyab">
  <p class="eyebrow">Friends</p>
  <h1>People I work with</h1>
  <p class="lede">
    A quick look at the people, communities, and spaces I hang out with
    online. Nothing fancy — just honest connections.
  </p>

  <hr class="divider" />

  <h2>Let's talk</h2>
  <p class="lede">
    If you've read something here and want to chat — about a project, a
    collaboration, or just offline-first software — I'm always open to
    a conversation.
  </p>

  <div class="callout callout-info">
    <h3 style="margin-bottom:8px">Work with me</h3>
    <p class="muted">
      I take on freelance work, collaborations, and conversations about
      offline-first software, clinic systems, or government tech.
    </p>
    <p style="margin-top:16px">
      <a class="btn btn-primary" href="/connect">Say hello →</a>
      <a class="btn btn-secondary" href="/projects">See my work →</a>
    </p>
  </div>
</Reading>