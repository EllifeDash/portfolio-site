---
import Base from "../layouts/Base.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<Base title={title} description={description} image={image}>
  <div class="reading">
    <div class="reading-main stack">
      <slot />
    </div>
    <aside class="reading-aside">
      <slot name="aside" />
    </aside>
  </div>
</Base>
