---
import type { CollectionEntry } from "astro:content";

interface Props {
  service: CollectionEntry<"services">;
}

const { service } = Astro.props;
const { data, id } = service;
const arrow =
  '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
---

<a class="card service-card" href={`/services/${id}`}>
  <h3>{data.title}</h3>
  <p class="muted" style="margin-top:6px">{data.blurb}</p>
  <span class="card-arrow" set:html={`Learn more ${arrow}`}></span>
</a>

<style>
  .service-card {
    padding: var(--space-5);
  }
  .service-card h3 {
    font-size: 1.15rem;
  }
  .service-card .card-arrow {
    padding-top: var(--space-4);
  }
</style>